// Paste this match inside the existing /databases/{database}/documents block.
match /winterEvents/christmas2026 {
  function school() {
    return request.auth != null
      && request.auth.token.email_verified == true
      && request.auth.token.firebase.sign_in_provider == 'google.com'
      && request.auth.token.email.lower().matches('([a-z]+[a-z][0-9]{2}|[a-z]+[.][a-z]+)@lakesideschool[.]org');
  }
  function signature(name) {
    let email = request.auth.token.email.lower();
    return name is string && (email == 'carolynj30@lakesideschool.org'
      ? name == 'Seek J'
      : (
        (name.matches('[A-Z][a-z]* [A-Z][a-z]*')
          && name.lower().replace(' ', '.') + '@lakesideschool.org' == email)
        || (name.matches('[A-Z][a-z]* [A-Z][.]')
          && email.matches(name.lower().replace(' ', '').replace('[.]', '') + '[0-9]{2}@lakesideschool[.]org'))
      ));
  }
  function released() {
    return request.time >= timestamp.date(2026,12,25) + duration.value(8,'h');
  }
  function treePath(id) {
    return /databases/$(database)/documents/winterEvents/christmas2026/trees/$(id);
  }
  function ownTreePath() {
    return /databases/$(database)/documents/winterEvents/christmas2026/members/$(request.auth.uid);
  }
  function validTreeId(id) {
    return id is string && id.matches('[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}');
  }
  function validTree(d) {
    return d.keys().hasOnly(['owner','name','species','setting','weather','star','visibility'])
      && signature(d.name)
      && d.species in ['Fir', 'Spruce', 'Blue cedar', 'Scots pine', 'Cypress', 'Western hemlock', 'Atlas cedar', 'Giant sequoia', 'Paper birch', 'Monkey puzzle', 'European larch', 'Stone pine'] && d.setting in ['Courtyard', 'Woodland', 'Alpine dusk', 'Frozen lake', 'Northern lights', 'Harbor lights', 'Solstice mill', 'Snowbound railway', 'Glasshouse garden', 'Skating pond', 'Clocktower market', 'Tidepool cove', 'Glacier grotto', 'Summit observatory', 'Heron marsh', 'Bookbindery lane']
      && d.weather in ['Snowfall', 'Clear', 'Flurries', 'Snowstorm', 'Diamond dust', 'Lake mist', 'Sleet', 'Feather snow', 'Spindrift', 'Ice halo', 'Graupel', 'Light pillars', 'Hoarfrost'] && d.star in ['None', 'Brass', 'Silver', 'Rose gold', 'Glass spire', 'Paper angel', 'Ribbon bow', 'Crescent moon', 'Solstice sun', 'Compass rose', 'Holly spray', 'Armillary sphere', 'Swallowtail pennant', 'Stained glass rosette', 'Tin swallow', 'Straw wheel']
      && d.visibility in ['Public','Private'];
  }
  match /calendar/reveal {
    allow get: if school() && released();
  }
  match /members/{uid} {
    allow get: if school() && request.auth.uid == uid;
    allow create: if school() && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['tree'])
      && validTreeId(request.resource.data.tree)
      && getAfter(treePath(request.resource.data.tree)).data.owner == uid;
  }
  match /postmarks/{uid} {
    function validMark() {
      return school() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['tree','at'])
        && validTreeId(request.resource.data.tree)
        && request.resource.data.at == request.time;
    }
    allow create: if validMark();
    allow update: if validMark() && request.time >= resource.data.at + duration.value(5,'s');
  }
  match /trees/{id} {
    allow get: if school();
    allow list: if school() && resource.data.visibility == 'Public';
    allow create: if school() && validTreeId(id) && validTree(request.resource.data)
      && request.resource.data.owner == request.auth.uid && getAfter(ownTreePath()).data.tree == id;
    allow update: if school() && resource.data.owner == request.auth.uid
      && request.resource.data.owner == request.auth.uid && validTree(request.resource.data);

    function sender(uid) {
      return school() && uid == request.auth.uid && get(treePath(id)).data.owner != uid;
    }
    function freshMark(uid) {
      let mark = getAfter(/databases/$(database)/documents/winterEvents/christmas2026/postmarks/$(uid)).data;
      return mark.at == request.time && mark.tree == id;
    }
    match /ornaments/{uid} {
      function validDecoration() {
        let d = request.resource.data;
        return sender(uid) && freshMark(uid)
          && d.keys().hasOnly(['kind','color','paper','visibility','name','created','updated'])
          && signature(d.name) && d.kind in ['Bell', 'Gift', 'Ribbon', 'Snowflake', 'Lantern', 'Mitten', 'Bauble', 'Heart', 'Crescent', 'Skate', 'Cardinal', 'Pinecone', 'Candle', 'Snowman', 'Apple', 'Candy cane', 'Gingerbread', 'Stocking', 'Jewel', 'Paper star', 'Mushroom', 'Teapot', 'Cabin', 'Fox', 'Wreath', 'Sled', 'Dove', 'Drum', 'Pocket watch', 'Painted pear', 'Tiny violin', 'Snow globe', 'Acorn', 'Wool scarf', 'Toy sailboat', 'Wrapped sweet', 'Brass key', 'Winter boot', 'Book', 'Arctic hare', 'Rocking horse', 'Snowy owl', 'Cocoa mug', 'Music box', 'Koi kite', 'Hourglass', 'Accordion', 'Clove pomander', 'Thread spool', 'Tram car', 'Fountain pen nib'] && d.color in ['Cranberry', 'Gold', 'Ice blue', 'Plum', 'Copper', 'Mint', 'Sapphire', 'Evergreen', 'Ivory', 'Mulberry', 'Tangerine', 'Rose quartz', 'Pewter', 'Peacock', 'Lampblack', 'Lichen', 'Ultramarine', 'Lilac chalk']
          && d.paper in ['Parchment', 'Botanical', 'Polar blue', 'Cranberry border', 'Linen weave', 'Music manuscript', 'Marbled jade', 'Airmail', 'Field notebook', 'Tide chart'] && d.visibility in ['Public','Private']
          && d.updated == request.time
          && getAfter(/databases/$(database)/documents/winterEvents/christmas2026/trees/$(id)/letters/$(uid)).data.updated == request.time;
      }
      allow get, list: if school();
      allow create: if validDecoration() && request.resource.data.created == request.time;
      allow update: if validDecoration() && request.resource.data.created == resource.data.created;
    }
    match /letters/{uid} {
      allow get: if school() && (uid == request.auth.uid || (released() && (
        get(treePath(id)).data.owner == request.auth.uid
        || get(/databases/$(database)/documents/winterEvents/christmas2026/trees/$(id)/ornaments/$(uid)).data.visibility == 'Public'
      )));
      allow create, update: if sender(uid) && freshMark(uid)
        && request.resource.data.keys().hasOnly(['message','updated'])
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.updated == request.time
        && getAfter(/databases/$(database)/documents/winterEvents/christmas2026/trees/$(id)/ornaments/$(uid)).data.updated == request.time;
    }
  }
}
